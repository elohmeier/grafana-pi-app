{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Assistant",
  "id": "g42-pi-app",
  "backend": true,
  "executable": "gpx_g42_pi_app",
  "info": {
    "keywords": ["app", "llm", "observability", "prometheus", "dashboards"],
    "description": "Grafana-native observability analyst for querying metrics, validating PromQL, and creating dashboards.",
    "author": {
      "name": "Enno Richter"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Assistant",
      "path": "/a/%PLUGIN_ID%/chat",
      "addToNav": true,
      "defaultNav": true,
      "icon": "heart-rate"
    }
  ],
  "extensions": {
    "addedLinks": [
      {
        "targets": ["grafana/dashboard/panel/menu"],
        "description": "Explain what this panel shows",
        "title": "Explain in Assistant"
      },
      {
        "targets": ["grafana/dashboard/panel/menu"],
        "description": "Diagnose why this panel may be empty, noisy, misleading, or unhealthy",
        "title": "Troubleshoot panel"
      },
      {
        "targets": ["grafana/dashboard/panel/menu"],
        "description": "Suggest query, visualization, threshold, and layout improvements for this panel",
        "title": "Suggest improvements"
      }
    ]
  },
  "roles": [
    {
      "role": {
        "name": "Access",
        "description": "Use the Assistant app.",
        "permissions": [{ "action": "g42-pi-app.app:access" }]
      },
      "grants": ["Admin"]
    }
  ],
  "iam": {
    "permissions": [
      { "action": "users.permissions:read", "scope": "users:*" },
      { "action": "dashboards:create", "scope": "folders:uid:*" },
      { "action": "dashboards:read", "scope": "folders:uid:*" },
      { "action": "dashboards:write", "scope": "folders:uid:*" },
      { "action": "folders:read", "scope": "folders:uid:*" }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
