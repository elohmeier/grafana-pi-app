{
  "name": "g42-pi-app",
  "version": "3.1.0",
  "scripts": {
    "generate:skills": "node scripts/generate-bundled-skills.mjs",
    "frontend:build": "npm run generate:skills && webpack -c ./webpack.config.ts --env production",
    "build": "npm run frontend:build",
    "build:variant": "node scripts/package-plugin-variant.mjs --build-only",
    "backend:build:linux-amd64": "go run github.com/magefile/mage -v build:linux",
    "backend:build:linux-arm64": "go run github.com/magefile/mage -v build:linuxARM64",
    "build:linux-amd64": "npm run frontend:build && npm run backend:build:linux-amd64",
    "build:linux-arm64": "npm run frontend:build && npm run backend:build:linux-arm64",
    "dev": "npm run generate:skills && webpack -w -c ./webpack.config.ts --env development",
    "test": "npm run generate:skills && jest --watch --onlyChanged",
    "test:ci": "npm run generate:skills && jest --passWithNoTests --maxWorkers 4",
    "typecheck": "npm run generate:skills && tsc --noEmit",
    "lint": "npm run generate:skills && eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "benchmark:agent": "node scripts/benchmark-agent.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs",
    "benchmark:artifact-jq": "node scripts/benchmark-artifact-jq.mjs",
    "benchmark:robust-dashboard": "node scripts/benchmark-robust-dashboard.mjs",
    "benchmark:thanos-cost-dashboard": "node scripts/benchmark-thanos-cost-dashboard.mjs",
    "benchmark:dashboard-plan-handoff": "node scripts/benchmark-dashboard-plan-handoff.mjs",
    "benchmark:dashboard-context": "node scripts/benchmark-dashboard-context.mjs",
    "benchmark:dashboard-editing": "node scripts/benchmark-dashboard-editing.mjs",
    "benchmark:dashboard-batch-editing": "node scripts/benchmark-dashboard-batch-editing.mjs",
    "benchmark:alert-troubleshooting": "node scripts/benchmark-alert-troubleshooting.mjs",
    "benchmark:dashboard-metric-discovery": "node scripts/benchmark-dashboard-metric-discovery.mjs",
    "benchmark:agent-contract-sample": "node scripts/benchmark-agent-contract-sample.mjs",
    "benchmark:explore-metrics": "node scripts/benchmark-explore-metrics.mjs",
    "dev:import:skills": "node scripts/sync-dev-plugin-provisioning.mjs",
    "dev:seed:samples": "node scripts/seed-dev-samples.mjs",
    "dev:import:dashboard": "node scripts/import-dashboard.mjs",
    "dev:import:dashboards": "node scripts/import-dashboards.mjs",
    "package:variant": "node scripts/package-plugin-variant.mjs",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "validate": "ID=$(jq -r .id dist/plugin.json) && VER=$(jq -r .info.version dist/plugin.json) && EXE=$(jq -r .executable dist/plugin.json) && find dist -maxdepth 1 -type f -name 'gpx_*' ! -name \"$EXE*\" -delete && ln -sfn dist $ID && zip -r $ID-$VER.zip $ID/ && rm $ID && npx --yes @grafana/plugin-validator@latest -sourceCodeUri file://./ $ID-$VER.zip; rm -f $ID-$VER.zip"
  },
  "author": "Elohmeier",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.8.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin-ts": "^4.4.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.0.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.5",
    "@earendil-works/pi-ai": "0.75.5",
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.0.1",
    "@grafana/i18n": "13.0.1",
    "@grafana/runtime": "13.0.1",
    "@grafana/scenes": "8.2.6",
    "@grafana/schema": "13.0.1",
    "@grafana/ui": "13.0.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8",
    "@prometheus-io/lezer-promql": "^0.307.3",
    "diff": "^8.0.4",
    "jq-wasm": "^1.1.0-jq-1.8.1",
    "just-bash": "^3.0.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "rxjs": "7.8.2",
    "typebox": "1.1.38"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "@remix-run/router": "1.23.3",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "immutable": "5.1.8",
    "js-cookie": "3.0.7",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "protobufjs@7": "7.6.5",
    "react-router@6": "6.30.4",
    "uuid@9": "11.1.1",
    "uuid@11": "11.1.1",
    "uuid@11.1.0": "11.1.1",
    "websocket-driver": "0.7.5"
  },
  "packageManager": "npm@11.12.1"
}
