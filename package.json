{
  "name": "g42-pi-app",
  "version": "2.5.1",
  "scripts": {
    "generate:skills": "node scripts/generate-bundled-skills.mjs",
    "frontend:build": "npm run generate:skills && webpack -c ./.config/webpack/webpack.config.ts --env production",
    "build": "npm run frontend:build",
    "backend:build:linux-amd64": "go run github.com/magefile/mage -v build:linux",
    "backend:build:linux-arm64": "go run github.com/magefile/mage -v build:linuxARM64",
    "build:linux-amd64": "npm run frontend:build && npm run backend:build:linux-amd64",
    "build:linux-arm64": "npm run frontend:build && npm run backend:build:linux-arm64",
    "dev": "npm run generate:skills && webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "npm run generate:skills && jest --watch --onlyChanged",
    "test:ci": "npm run generate:skills && jest --passWithNoTests --maxWorkers 4",
    "typecheck": "npm run generate:skills && tsc --noEmit",
    "lint": "npm run generate:skills && eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "benchmark:agent": "node scripts/benchmark-agent.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs",
    "benchmark:artifact-jq": "node scripts/benchmark-artifact-jq.mjs",
    "benchmark:dashboard-context": "node scripts/benchmark-dashboard-context.mjs",
    "benchmark:explore-metrics": "node scripts/benchmark-explore-metrics.mjs",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "validate": "ID=$(jq -r .id dist/plugin.json) && VER=$(jq -r .info.version dist/plugin.json) && EXE=$(jq -r .executable dist/plugin.json) && find dist -maxdepth 1 -type f -name 'gpx_*' ! -name \"$EXE*\" -delete && ln -sfn dist $ID && zip -r $ID-$VER.zip $ID/ && rm $ID && npx --yes @grafana/plugin-validator@latest -sourceCodeUri file://./ $ID-$VER.zip; rm -f $ID-$VER.zip"
  },
  "author": "Elohmeier",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.8.0",
    "@grafana/tsconfig": "^2.1.0",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin-ts": "^4.4.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.0.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.5",
    "@earendil-works/pi-ai": "0.75.5",
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.0.1",
    "@grafana/i18n": "13.0.1",
    "@grafana/runtime": "13.0.1",
    "@grafana/scenes": "8.2.6",
    "@grafana/schema": "13.0.1",
    "@grafana/ui": "13.0.1",
    "jq-wasm": "^1.1.0-jq-1.8.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "rxjs": "7.8.2",
    "typebox": "1.1.38"
  },
  "packageManager": "npm@11.12.1"
}
